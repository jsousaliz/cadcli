<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{44B8C8E5-2FFC-43B0-AF29-AC98903DF6A3}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="CadCli.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="tests\CadCli.Testes.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="CadCli">
        <MSBuild Projects="CadCli.dproj"/>
    </Target>
    <Target Name="CadCli:Clean">
        <MSBuild Projects="CadCli.dproj" Targets="Clean"/>
    </Target>
    <Target Name="CadCli:Make">
        <MSBuild Projects="CadCli.dproj" Targets="Make"/>
    </Target>
    <Target Name="CadCli_Testes">
        <MSBuild Projects="tests\CadCli.Testes.dproj"/>
    </Target>
    <Target Name="CadCli_Testes:Clean">
        <MSBuild Projects="tests\CadCli.Testes.dproj" Targets="Clean"/>
    </Target>
    <Target Name="CadCli_Testes:Make">
        <MSBuild Projects="tests\CadCli.Testes.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="CadCli;CadCli_Testes"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="CadCli:Clean;CadCli_Testes:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="CadCli:Make;CadCli_Testes:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
