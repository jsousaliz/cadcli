        <PostBuildEvent>powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\CopiarBplsEntrega.ps1&quot; -Executavel &quot;$(MSBuildProjectDirectory)\$(DCC_ExeOutput)\$(MSBuildProjectName).exe&quot; -Origens &quot;$(BDS)\bin64;$(DXVCL)\Library\RS29\Win64&quot;</PostBuildEvent>
        <PostBuildEventIgnoreExitCode>False</PostBuildEventIgnoreExitCode>
    </PropertyGroup>
