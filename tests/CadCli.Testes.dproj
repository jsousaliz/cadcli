<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{36A79882-349E-41A5-882A-D716E05A953B}</ProjectGuid>
    <ProjectVersion>20.3</ProjectVersion>
    <FrameworkType>VCL</FrameworkType>
    <MainSource>CadCli.Testes.dpr</MainSource>
    <Base>True</Base>
    <Config Condition="'$(Config)'==''">Debug</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>2</TargetedPlatforms>
    <AppType>Console</AppType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
    <Cfg_1>true</Cfg_1>
    <CfgParent>Base</CfgParent>
    <Base>true</Base>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Base)'!=''">
    <DCC_UnitSearchPath>Unitarios;Suporte;..\src\Dominio;..\src\Aplicacao;..\src\Infraestrutura;..\src\Migracoes;$(BDS)\source\DUnitX;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;Winapi;Vcl;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UsePackage>false</DCC_UsePackage>
    <DCC_ExeOutput>bin\$(Platform)\$(Config)</DCC_ExeOutput>
    <DCC_DcuOutput>bin\$(Platform)\$(Config)\dcu</DCC_DcuOutput>
    <DCC_ConsoleTarget>true</DCC_ConsoleTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cfg_1)'!=''">
    <DCC_Define>DEBUG;CI;$(DCC_Define)</DCC_Define>
    <DCC_DebugInformation>2</DCC_DebugInformation>
    <DCC_LocalDebugSymbols>true</DCC_LocalDebugSymbols>
    <DCC_Optimize>false</DCC_Optimize>
  </PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)">
      <MainSource>MainSource</MainSource>
    </DelphiCompile>
    <DCCReference Include="Suporte\Suporte.CaminhosTeste.pas" />
    <DCCReference Include="Suporte\Suporte.FakesMigracao.pas" />
    <DCCReference Include="Unitarios\Testes.CatalogoExecutor.pas" />
    <DCCReference Include="Unitarios\Testes.EntregaRunner.pas" />
    <DCCReference Include="Unitarios\Testes.InicializadorAplicacao.pas" />
    <DCCReference Include="Unitarios\Testes.IntegracaoFirebird.pas" />
    <DCCReference Include="..\src\Dominio\Dominio.Migracao.pas" />
    <DCCReference Include="..\src\Aplicacao\Aplicacao.CatalogoMigracoes.pas" />
    <DCCReference Include="..\src\Aplicacao\Aplicacao.ExecutorMigracoes.pas" />
    <DCCReference Include="..\src\Aplicacao\Aplicacao.InicializadorAplicacao.pas" />
    <DCCReference Include="..\src\Infraestrutura\Infraestrutura.CatalogoPadraoMigracoes.pas" />
    <DCCReference Include="..\src\Infraestrutura\Infraestrutura.ContextoMigracaoFireDAC.pas" />
    <DCCReference Include="..\src\Infraestrutura\Infraestrutura.InicializadorBancoFireDAC.pas" />
    <DCCReference Include="..\src\Infraestrutura\Infraestrutura.RegistroErroInicializacao.pas" />
    <DCCReference Include="..\src\Migracoes\Migracao.V001.EsquemaInicial.pas" />
    <DCCReference Include="..\src\Migracoes\Migracao.V002.DadosReferencia.pas" />
    <BuildConfiguration Include="Debug">
      <Key>Cfg_1</Key>
      <CfgParent>Base</CfgParent>
    </BuildConfiguration>
    <BuildConfiguration Include="Base">
      <Key>Base</Key>
    </BuildConfiguration>
  </ItemGroup>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')" />
  <ProjectExtensions>
    <Borland.Personality>Delphi.Personality.12</Borland.Personality>
    <Borland.ProjectType>Application</Borland.ProjectType>
    <BorlandProject>
      <Delphi.Personality>
        <Source>
          <Source Name="MainSource">CadCli.Testes.dpr</Source>
        </Source>
        <Platforms>
          <Platform value="Win64">True</Platform>
        </Platforms>
      </Delphi.Personality>
    </BorlandProject>
  </ProjectExtensions>
</Project>
